#################################################################################################################################################################
########### Import                                                                                                                                     [ Import ]
##### Internal                                                                                                                               [ Import, Internal ]
##### External                                                                                                                               [ Import, External ]
load("@rules_rust//rust:defs.bzl", "rust_library")

##### Visibility                                                                                                                                       [ Module ]
package(default_visibility = [
    "//system/generation/web:__pkg__",
    "//system/generation/web:__subpackages__",
])

##### Module                                                                                                                                           [ Module ]
rust_library(
    name = "assembler",
    srcs = ["assembler.rs"],
    deps = [
        ":error",
        "//component/web:element",
    ],
)

rust_library(
    name = "error",
    srcs = ["error.rs"],
    deps = [
        "@crates//:miette",
        "@crates//:thiserror",
    ],
)

rust_library(
    name = "escape",
    srcs = ["escape.rs"],
    aliases = {
        "//component/web/render:escape": "portable",
    },
    visibility = ["//visibility:public"],
    deps = [
        "//component/web/render:escape",
    ],
)

rust_library(
    name = "walker",
    srcs = ["walker.rs"],
    deps = [
        ":escape",
        "@crates//:tree-sitter",
    ],
)

rust_library(
    name = "rust",
    srcs = ["rust.rs"],
    aliases = {
        "//component/web/class:node": "node",
        "//component/web/class:reference": "reference",
        "//component/web/class:syntax": "syntax",
        "//component/web/render:escape": "portable",
    },
    deps = [
        ":assembler",
        ":error",
        "//component/web:element",
        "//component/web/class:node",
        "//component/web/class:reference",
        "//component/web/class:syntax",
        "//component/web/render:escape",
        "//component/web/render:fragment",
        "@crates//:miette",
        "@crates//:quote",
        "@crates//:syn",
    ],
)

rust_library(
    name = "molten",
    srcs = ["molten.rs"],
    aliases = {
        "//Molten/system/graph/symbolic:traversal": "token",
        "//component/web/class:node": "node",
        "//component/web/class:reference": "reference",
    },
    deps = [
        ":assembler",
        ":error",
        "//Molten:component",
        "//Molten/system/graph/symbolic:traversal",
        "//component/web:element",
        "//component/web/class:node",
        "//component/web/class:reference",
        "//component/web/render:fragment",
        "@crates//:miette",
    ],
)

rust_library(
    name = "json",
    srcs = ["json.rs"],
    aliases = {
        "//Molten/system/graph/symbolic:traversal": "token",
        "//component/web/attribute:difference": "marker",
        "//component/web/class:dashboard": "dashboard",
        "//component/web/class:node": "node",
        "//component/web/class:reference": "reference",
        "//component/web/class:syntax": "syntax",
        "//component/web/dashboard:difference": "difference",
    },
    visibility = ["//visibility:public"],
    deps = [
        ":assembler",
        ":error",
        "//Molten/system/graph/symbolic:traversal",
        "//component/web:element",
        "//component/web/attribute:difference",
        "//component/web/class:dashboard",
        "//component/web/class:node",
        "//component/web/class:reference",
        "//component/web/class:syntax",
        "//component/web/dashboard:difference",
        "//component/web/render:fragment",
        "//system/graph/symbolic:traversal",
        "@crates//:miette",
        "@crates//:serde_json",
    ],
)

rust_library(
    name = "starlark",
    srcs = ["starlark.rs"],
    deps = [
        "@crates//:tree-sitter",
    ],
)

rust_library(
    name = "bash",
    srcs = ["bash.rs"],
    deps = [
        "@crates//:tree-sitter",
    ],
)

##### Documentation                                                                                                                             [ Documentation ]
